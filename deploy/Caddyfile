{
	admin off
	auto_https off
	servers {
		# the host Caddy forwards from a private address: take the client IP from X-Forwarded-For
		trusted_proxies static private_ranges
	}
}

:8080 {
	# dynamic responses (/api/mgate); static files come precompressed (.zst/.gz from the build)
	encode zstd gzip

	# container healthcheck (not in the access log)
	handle /healthz {
		log_skip
		respond "ok" 200
	}

	header {
		# strict CSP: no inline scripts; map tiles from OpenFreeMap / OpenRailwayMap
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://tiles.openfreemap.org https://tile.openstreetmap.org https://a.tiles.openrailwaymap.org; worker-src 'self' blob:; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types default vue"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		X-Frame-Options DENY
		-Server
	}

	# access log on stdout → `journalctl --user -u zugx` (stock console format, headers dropped, IPs masked)
	log {
		output stdout
		format filter {
			wrap console {
				level_format upper
			}
			fields {
				request>headers delete
				# no full client IPs in the log (personal data): keep /24 resp. /48 for abuse analysis
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
				request>tls delete
				resp_headers delete
				user_id delete
			}
		}
	}

	handle /api/mgate {
		@notPost not method POST
		respond @notPost 405

		request_body {
			max_size 8KB
		}

		rewrite * /bin/mgate.exe
		reverse_proxy https://fahrplan.oebb.at {
			# HAFAS rejects any Host other than exactly "fahrplan.oebb.at"
			header_up Host fahrplan.oebb.at
			header_up User-Agent "zugx (https://zugx.legner.me)"
			header_up -Cookie
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -Origin
			header_up -Referer
			header_down -Set-Cookie
		}
	}

	handle {
		root * /srv
		# fingerprinted files (Vite: name-<8-char content hash>.ext; under /assets/ and the
		# service worker's workbox-<hash>.js): the content never changes under that name — cache
		# for a year without revalidating (immutable)
		@hashed {
			path_regexp ^/(assets/.+|workbox)-[A-Za-z0-9_-]{8}\.[a-z0-9]+$
			file
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# everything else revalidates (ETag / Last-Modified, 304): index.html for every SPA route,
		# the service worker, the manifest, icons, routing data — a deploy shows on the next load
		@revalidate not {
			path_regexp ^/(assets/.+|workbox)-[A-Za-z0-9_-]{8}\.[a-z0-9]+$
			file
		}
		header @revalidate Cache-Control "no-cache"
		# Caddy doesn't know .webmanifest
		header /manifest.webmanifest Content-Type application/manifest+json
		# SPA routes fall back to index.html — but not /assets/: a chunk that isn't there (an old one
		# after a deploy) is a plain 404 (index.html under a .js name would break the app; the client
		# reloads once on a failed chunk, main.ts)
		@spa {
			not path /assets/*
			not file
		}
		rewrite @spa /index.html
		file_server {
			precompressed zstd gzip
		}
	}
}
