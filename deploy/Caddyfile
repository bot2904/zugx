{
	admin off
	auto_https off
	servers {
		# the host Caddy forwards from a private address: take the client IP from X-Forwarded-For
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	# container healthcheck (not in the access log)
	handle /healthz {
		log_skip
		respond "ok" 200
	}

	header {
		# strict CSP: no inline scripts; map tiles from OpenFreeMap / OpenRailwayMap
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://tiles.openfreemap.org https://tile.openstreetmap.org https://a.tiles.openrailwaymap.org; worker-src 'self' blob:; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types default vue"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		X-Frame-Options DENY
		-Server
	}

	# access log on stdout → `journalctl --user -u zugx` (stock console format, headers dropped)
	log {
		output stdout
		format filter {
			wrap console {
				level_format upper
			}
			fields {
				request>headers delete
				request>tls delete
				resp_headers delete
				user_id delete
			}
		}
	}

	handle /api/mgate {
		@notPost not method POST
		respond @notPost 405

		request_body {
			max_size 8KB
		}

		rewrite * /bin/mgate.exe
		reverse_proxy https://fahrplan.oebb.at {
			# HAFAS rejects any Host other than exactly "fahrplan.oebb.at"
			header_up Host fahrplan.oebb.at
			header_up User-Agent "zugx (https://zugx.legner.me)"
			header_up -Cookie
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -Origin
			header_up -Referer
			header_down -Set-Cookie
		}
	}

	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@nocache path / /sw.js /registerSW.js /index.html /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
