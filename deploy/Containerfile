# zugx: static Vue SPA + /api/mgate reverse proxy, served by Caddy (plain HTTP :8080).
# Build: podman build -t localhost/zugx -f deploy/Containerfile .
FROM docker.io/library/node:24-alpine AS build
WORKDIR /app
RUN npm install -g pnpm@12.18.0
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY packages/hafas/package.json packages/hafas/
COPY packages/stations/package.json packages/stations/
COPY packages/trains/package.json packages/trains/
COPY packages/netz/package.json packages/netz/
COPY packages/gtfs/package.json packages/gtfs/
COPY e2e/package.json e2e/
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN pnpm install --frozen-lockfile
COPY . .
# .git is not in the build context: CI passes the commit as build args (footer version)
ARG VITE_COMMIT_HASH=""
ARG VITE_COMMIT_DATE=""
ENV VITE_COMMIT_HASH=$VITE_COMMIT_HASH VITE_COMMIT_DATE=$VITE_COMMIT_DATE
RUN cd apps/web && pnpm exec vp build

FROM docker.io/library/caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv
EXPOSE 8080
